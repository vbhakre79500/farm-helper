# MONSOON-SENSE Environment Configuration Template

# Frontend & Authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# PostgreSQL + PostGIS Geospatial Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/monsoonsense

# Weather Data Provider (Open-Meteo operational feeds)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# Planetary Climate Feeds (NOAA CPC, Australian BoM)
NOAA_CPC_BASE_URL=https://www.cpc.ncep.noaa.gov/data/indices
BOM_BASE_URL=http://www.bom.gov.au/climate/enso/indices

# Satellite Reanalysis Feeds (Copernicus CDS / ECMWF)
COPERNICUS_API_URL=https://cds.climate.copernicus.eu/api/v2
COPERNICUS_API_KEY=

# Geospatial Tiles & Attribution
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Geocoding Provider
GEOCODING_PROVIDER=open-meteo
GEOCODING_API_KEY=

# Notification & Early Warning Gateways
SMS_PROVIDER=cdac-sms-gateway
SMS_API_KEY=
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
